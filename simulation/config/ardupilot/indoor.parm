# Claude Drone — indoor параметры без GPS
# GPS отключён
GPS1_TYPE 0

# Арминг без проверок
ARMING_SKIPCHK 1

# Высота с rangefinder
EK3_SRC1_POSZ 2

# Оптический поток
FLOW_TYPE 6
EK3_SRC1_VELXY 5
EK3_SRC1_POSXY 0

# Медленный полёт indoor
LOIT_SPEED_MS 3.0
PILOT_SPD_UP 1.0

# Геозабор — виртуальные границы полёта
# ArduPilot следит за позицией и реагирует если дрон вышел за границы

# Включить геозабор
# 0 = выключен, 1 = включён
FENCE_ENABLE 1

# Тип забора — ЧТО ограничиваем
# Это битовая маска — числа складываются:
# 1 = минимальная высота (пол)
# 2 = максимальная высота (потолок)  ← нам нужно это
# 4 = круговой радиус
# 8 = полигон (произвольная форма)
# Примеры: 3 = пол+потолок, 6 = потолок+круг, 7 = пол+потолок+круг
FENCE_TYPE 2

# Максимальная высота в метрах
# Комната 3м — ставим 2.5м чтобы был запас до потолка
FENCE_ALT_MAX 2.5

# Действие при нарушении границы — ЧТО ДЕЛАЕТ дрон
# 0 = ничего (только лог)
# 1 = RTL (возврат домой и посадка)
# 2 = Land (сесть на месте)
# 3 = SmartRTL или Land если SmartRTL недоступен
# 4 = Brake (зависнуть на месте) ← лучше для indoor
# 6 = Avoid (попытаться вернуться в зону)
FENCE_ACTION 4
# Отключить проверку батареи в симуляции
BATT_MONITOR 0
