# Claude Drone indoor params (no GPS).
# IMPORTANT: ASCII only, lines <80 chars. Long lines or Cyrillic break the
# ArduPilot defaults parser (100-byte fgets buffer + line[0]=='#' comment
# check) -> tail of long line parsed as bogus param name -> done_all_default
# stays false -> reload_defaults_file fires every param load = crash loop,
# no MAVLink heartbeat. See docs/dev-log/05-indoor-parm-cyrillic-loop.md.

# GPS enabled for SITL fake GPS (origin auto-set, position control works).
# Real hardware future: disable to use optflow only.
GPS1_TYPE 1

# Skip all pre-arm checks (ARMING_SKIPCHK is the 4.7+ name; old ARMING_CHECK).
ARMING_SKIPCHK 1

# EKF default sources (GPS enabled, no AHRS_OPTIONS overrides).
# EK3_SRC1_POSZ default = baro. EK3_SRC1_POSXY default = GPS.

# Indoor slow flight
LOIT_SPEED_MS 3.0
PILOT_SPD_UP 1.0

# Geofence original pre-session config.
FENCE_ENABLE 0
FENCE_TYPE 3
FENCE_ALT_MAX 2.5
FENCE_RADIUS 3.5
FENCE_MARGIN 0.5
FENCE_ACTION 4

# Disable battery monitor (sim has no battery)
BATT_MONITOR 0

# Baseline pre-session.
WPNAV_ACCEL 50
# Attempt #19 RCA (2026-05-20): WPNAV_SPEED 30 (30 cm/s) was OK, but
# combined with 45 deg ANGLE_MAX (ATC_ANGLE_MAX 4500) drone lost 0.28 m
# of altitude per 1 m XY move. Lock WPNAV to 20 cm/s + ANGLE_MAX 15 deg.
WPNAV_SPEED 20
PILOT_ACCEL_Z 100
ATC_ANGLE_MAX 15

# Boost z velocity P gain для faster recovery от tilt-induced altitude loss.
# Default 5.0, doubled to 10.0 после attempt #19 diagnostic.
PSC_VELZ_P 10.0

# DISARM_DELAY 0: cheap insurance against slow setpoint publisher startup.
DISARM_DELAY 0

# GUID_OPTIONS bit 6 (=64): waypoint nav for position targets in GUIDED.
# Enables position setpoints to trigger takeoff when drone on ground.
GUID_OPTIONS 64

# v2 night watch (2026-06-07): yaw отслеживался ~15°/с → rotate-действия
# (15-120°) ловили arrival timeout 8s у стен. Ресёрч: в GUIDED yaw гонит
# attitude-цепочка (НЕ WPNAV); потолки — rate и accel. 90°/с + 360°/с²
# безопасно для indoor small quad SITL. (Баг 4.0 guided-yaw в 4.5 уже пофикшен.)
ATC_RATE_Y_MAX 90
ATC_ACCEL_Y_MAX 36000
