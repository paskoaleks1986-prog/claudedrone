# .env_simulation — copy to ../../../.env_simulation (one level above the repo)
# All paths are absolute. Variables may reference $WS_DIR after it's defined.

# Path to the simulation ROS2 workspace (the colcon root).
WS_DIR=

# ROS2 setup script.
ROS_SETUP=/opt/ros/jazzy/setup.bash

# ArduPilot source tree (contains ArduCopter/sim_vehicle.py).
ARDUPILOT_DIR=

# ardupilot_gazebo plugin/models tree.
ARDUPILOT_GZ_DIR=

# Default world (without .sdf) and the directory that holds *.sdf worlds.
DEFAULT_WORLD=indoor_room
WORLD_DIR=$WS_DIR/src/drone_sim/worlds

# Default ArduPilot params file and the directory that holds *.parm files.
DEFAULT_PARAMS=$WS_DIR/config/ardupilot/indoor.parm
PARAMS_DIR=$WS_DIR/config/ardupilot

# ROS2 launch package + file used by `-ros`.
LAUNCH_FILE=drone.launch.py
LAUNCH_PKG=drone_sim

# Authoritative GZ_SIM_RESOURCE_PATH (colon-separated). Must include both
# the package's models/ and any third-party model trees the worlds depend on.
GZ_RESOURCE_EXTRA=$WS_DIR/src/drone_sim/models:$ARDUPILOT_GZ_DIR/models

# Where -log writes per-pane logs.
LOG_DIR=

# Where capture.sh writes screenshots and video.
MEDIA_DIR=

# ─── D2 multi-instance isolation (TASK-033) ──────────────────────────────────
# Allow running simulation, researchbest, rl-lab in parallel on D2 without port,
# Gazebo topic, or ROS graph collisions. Each agent picks its own instance.
# Convention: simulation=0, researchbest=1, rl-lab=2.

# ArduPilot SITL instance id (passed as `-I $SITL_INSTANCE` to sim_vehicle.py).
# Determines MAVLink TCP port: base 5760 + 10*INSTANCE.
SITL_INSTANCE=0

# MAVLink TCP port arducopter listens on. Must match 5760 + 10*SITL_INSTANCE.
# launch.sh pre-flight-checks this is free; if not, ERROR with cleanup hint.
MAVLINK_PORT=5760

# Gazebo topic broadcast namespace (export GZ_PARTITION before gz sim/bridge).
# Different partitions = isolated topic graphs (won't see each other's /clock,
# /sensors, etc).
GZ_PARTITION=sim

# ROS2 DDS graph isolation. Different DOMAIN_IDs = different ROS graphs.
# Range 0-101 (101 reserved). Convention: simulation=0, researchbest=42, rl-lab=84.
ROS_DOMAIN_ID=0

# Gazebo headless mode (1 = `gz sim -s`, server only, no GUI render).
# simulation default = 0 (GUI), researchbest/rl-lab default = 1 (batch).
GZ_HEADLESS=0
