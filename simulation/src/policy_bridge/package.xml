<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>policy_bridge</name>
  <version>0.0.0</version>
  <description>SWEEP-02 RL policy bridge — ROS2 nodes that connect Gazebo sensors to a trained PPO policy and translate discrete actions into MAVROS velocity commands. Sprint model-to-sim-bridge Phase 1 (TASK-059).</description>
  <maintainer email="paskoaleks1986@gmail.com">aleks</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>python3-numpy</depend>
  <!-- stable-baselines3 + torch живут в simulation/.venv-policy/, не в rosdep -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
