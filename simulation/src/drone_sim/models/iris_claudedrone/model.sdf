      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_3</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_3</link_name>
    </plugin>

    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_0_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_1_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_2_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_3_joint</joint_name>
    </plugin>

    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <!-- Port settings -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>

      <!-- Frame conventions
        Require by ArduPilot: change model and gazebo from XYZ to XY-Z coordinates
      -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>iris_with_standoffs::imu_link::imu_sensor</imuName>

      <!--
          incoming control command [0, 1]
          so offset it by 0 to get [0, 1]
          and divide max target by 1.
          offset = 0
          multiplier = 838 max rpm / 1 = 838
        -->
      <control channel="0">
        <jointName>iris_with_standoffs::rotor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <control channel="1">
        <jointName>iris_with_standoffs::rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <control channel="2">
        <jointName>iris_with_standoffs::rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <control channel="3">
        <jointName>iris_with_standoffs::rotor_3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

    </plugin>


<!-- ============================================================
         CLAUDE DRONE SENSORS
         Добавлены поверх iris модели
    ============================================================ -->
    <link name="sensors_link">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <!-- TF LUNA ВНИЗ — высота над полом -->
      <sensor name="tf_luna_down" type="gpu_lidar">
        <pose>0 0 -0.05 0 1.5708 0</pose>
        <topic>/drone/tf_luna_down</topic>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </lidar>
      </sensor>

      <!-- TF LUNA ВПЕРЁД (sweep-сенсор) перенесён на sg90_arm —
           см. ниже link sg90_arm. Здесь больше не объявляется. -->

      <!-- VL53L0X x6 — периметр 360° -->
      <!-- VL0 — 0° ПЕРЕД -->
      <sensor name="vl53l0x_0" type="gpu_lidar">
        <pose>0.1 0 0 0 0 0</pose>
        <topic>/drone/vl53l0x/ch0</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL1 — 60° ПЕРЕД-ПРАВО -->
      <sensor name="vl53l0x_1" type="gpu_lidar">
        <pose>0.05 0.087 0 0 0 1.0472</pose>
        <topic>/drone/vl53l0x/ch1</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL2 — 120° ЗАД-ПРАВО -->
      <sensor name="vl53l0x_2" type="gpu_lidar">
        <pose>-0.05 0.087 0 0 0 2.0944</pose>
        <topic>/drone/vl53l0x/ch2</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL3 — 180° ЗАД -->
      <sensor name="vl53l0x_3" type="gpu_lidar">
        <pose>-0.1 0 0 0 0 3.1416</pose>
        <topic>/drone/vl53l0x/ch3</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL4 — 240° ЗАД-ЛЕВО -->
      <sensor name="vl53l0x_4" type="gpu_lidar">
        <pose>-0.05 -0.087 0 0 0 4.1888</pose>
        <topic>/drone/vl53l0x/ch4</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL5 — 300° ПЕРЕД-ЛЕВО -->
      <sensor name="vl53l0x_5" type="gpu_lidar">
        <pose>0.05 -0.087 0 0 0 5.2360</pose>
        <topic>/drone/vl53l0x/ch5</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

    </link>

    <!-- Joint — крепим sensors_link к корпусу iris -->
    <joint name="sensors_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>sensors_link</child>
    </joint>

<!-- ============================================================
         SG90 SERVO — поворотная платформа для TF-Luna
         Корпус наверху дрона, ось вращения вертикальна
         (рог сервы движется в плоскости параллельной полу)
         Диапазон: 0..180° (0..π рад)
    ============================================================ -->
    <link name="sg90_base">
      <pose>0 0 0.13 0 0 0</pose>
      <inertial>
        <mass>0.009</mass>
        <inertia>
          <ixx>0.0000007</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000010</iyy><iyz>0</iyz>
          <izz>0.0000007</izz>
        </inertia>
      </inertial>
      <visual name="sg90_base_visual">
        <geometry>
          <box>
            <size>0.023 0.012 0.022</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.6 1</ambient>
          <diffuse>0.1 0.1 0.6 1</diffuse>
        </material>
      </visual>
      <collision name="sg90_base_collision">
        <geometry>
          <box>
            <size>0.023 0.012 0.022</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="sg90_arm">
      <pose>0 0 0.146 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000001</iyy><iyz>0</iyz>
          <izz>0.0000001</izz>
        </inertia>
      </inertial>
      <visual name="sg90_arm_visual">
        <pose>0.0125 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.005 0.003</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="sg90_arm_collision">
        <pose>0.0125 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.005 0.003</size>
          </box>
        </geometry>
      </collision>

      <!-- Корпус TF-Luna на конце руки (визуально) —
           сенсор стоит вертикально (перпендикулярно полу),
           так что его луч идёт горизонтально наружу (+X arm-local).
           При вращении sg90_joint 0..π луч сметает плоскость
           параллельную полу. -->
      <visual name="tf_luna_body_visual">
        <pose>0.025 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.012 0.020 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <!-- TF-Luna sweep-сенсор. Топик /scan/sweep по acceptance.
           Луч направлен по +X руки (горизонтально) — при servo=0
           смотрит вперёд дрона, при servo=π — назад через левую сторону. -->
      <sensor name="tf_luna_sweep" type="gpu_lidar">
        <pose>0.025 0 0.005 0 0 0</pose>
        <topic>/scan/sweep</topic>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.2</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <!-- Корпус сервы — фикс к корпусу дрона -->
    <joint name="sg90_base_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>sg90_base</child>
    </joint>

    <!-- Сама серва — revolute joint, ось Z (перпендикулярна полу),
         диапазон 0..180° -->
    <joint name="sg90_joint" type="revolute">
      <parent>sg90_base</parent>
      <child>sg90_arm</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>3.14159</upper>
          <effort>0.2</effort>
          <velocity>6.0</velocity>
        </limit>
        <dynamics>
          <damping>0.001</damping>
          <friction>0.0001</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Контроллер позиции для SG90.
         Команда: радианы, топик /drone/sg90/cmd (gz topic -t /drone/sg90/cmd -m gz.msgs.Double -p "data: 1.57")
         После моста gz↔ROS2 будет ros2 topic /drone/sg90/cmd (std_msgs/Float64). -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>sg90_joint</joint_name>
      <topic>/drone/sg90/cmd</topic>
      <p_gain>1.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.05</d_gain>
      <i_max>0.5</i_max>
      <i_min>-0.5</i_min>
      <cmd_max>0.2</cmd_max>
      <cmd_min>-0.2</cmd_min>
    </plugin>

  </model>
</sdf>
