<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="claudedrone">
    <!-- if you want the model stay one position -->
    <static>true</static>

    <pose>0 0 1.0 0 0 0</pose>

    <link name="base_link">

      <!-- Масса и инерция -->
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.014</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.014</iyy><iyz>0</iyz>
          <izz>0.024</izz>
        </inertia>
      </inertial>

      <!-- Физическая форма -->
      <collision name="body_col">
        <geometry>
          <box><size>0.18 0.18 0.06</size></box>
        </geometry>
      </collision>

      <!-- Основной корпус — тёмный -->
      <visual name="body_vis">
        <geometry>
          <box><size>0.18 0.18 0.04</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Arm 1 — перед-право -->
      <visual name="arm1">
        <pose>0.07 0.07 0 0 0 0.785</pose>
        <geometry>
          <box><size>0.14 0.03 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Arm 2 — перед-лево -->
      <visual name="arm2">
        <pose>-0.07 0.07 0 0 0 -0.785</pose>
        <geometry>
          <box><size>0.14 0.03 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Arm 3 — зад-право -->
      <visual name="arm3">
        <pose>0.07 -0.07 0 0 0 -0.785</pose>
        <geometry>
          <box><size>0.14 0.03 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Arm 4 — зад-лево -->
      <visual name="arm4">
        <pose>-0.07 -0.07 0 0 0 0.785</pose>
        <geometry>
          <box><size>0.14 0.03 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Моторы — красные цилиндры -->
      <visual name="motor1">
        <pose>0.12 0.12 0.01 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.03</length></cylinder>
        </geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>

      <visual name="motor2">
        <pose>-0.12 0.12 0.01 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.03</length></cylinder>
        </geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>

      <visual name="motor3">
        <pose>0.12 -0.12 0.01 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.03</length></cylinder>
        </geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>

      <visual name="motor4">
        <pose>-0.12 -0.12 0.01 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.03</length></cylinder>
        </geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- Индикатор перед — зелёный -->
      <visual name="front_indicator">
        <pose>0.09 0 0.02 0 0 0</pose>
        <geometry>
          <box><size>0.02 0.02 0.02</size></box>
        </geometry>
        <material><ambient>0.1 0.9 0.1 1</ambient><diffuse>0.1 0.9 0.1 1</diffuse></material>
      </visual>

      <!-- ============================================================
           TF LUNA ВНИЗ — высота над полом
      ============================================================ -->
      <sensor name="tf_luna_down" type="gpu_lidar">
        <pose>0 0 -0.03 0 1.5708 0</pose>
        <topic>/drone/tf_luna_down</topic>
        <update_rate>10</update_rate>
        <!-- add visualisation for sensors -->
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </lidar>
      </sensor>

      <!-- ============================================================
           TF LUNA ВПЕРЁД — 2D скан
      ============================================================ -->
      <sensor name="tf_luna_front" type="gpu_lidar">
        <pose>0.09 0 0 0 0 0</pose>
        <topic>/drone/tf_luna_scan</topic>
        <update_rate>10</update_rate>
        <!-- add visualisation for sensors -->
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.2</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>

      <!-- ============================================================
           VL53L0X x6 — периметр 360°
      ============================================================ -->

      <!-- VL0 — 0° ПЕРЕД -->
      <sensor name="vl53l0x_0" type="gpu_lidar">
        <pose>0.09 0 0 0 0 0</pose>
        <topic>/drone/vl53l0x/ch0</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL1 — 60° ПЕРЕД-ПРАВО -->
      <sensor name="vl53l0x_1" type="gpu_lidar">
        <pose>0.045 0.078 0 0 0 1.0472</pose>
        <topic>/drone/vl53l0x/ch1</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL2 — 120° ЗАД-ПРАВО -->
      <sensor name="vl53l0x_2" type="gpu_lidar">
        <pose>-0.045 0.078 0 0 0 2.0944</pose>
        <topic>/drone/vl53l0x/ch2</topic>
        <update_rate>10</update_rate>
        <!-- add visualisation for sensors -->
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL3 — 180° ЗАД -->
      <sensor name="vl53l0x_3" type="gpu_lidar">
        <pose>-0.09 0 0 0 0 3.1416</pose>
        <topic>/drone/vl53l0x/ch3</topic>
        <update_rate>10</update_rate>
        <!-- add visualisation for sensors -->
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL4 — 240° ЗАД-ЛЕВО -->
      <sensor name="vl53l0x_4" type="gpu_lidar">
        <pose>-0.045 -0.078 0 0 0 4.1888</pose>
        <topic>/drone/vl53l0x/ch4</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

      <!-- VL5 — 300° ПЕРЕД-ЛЕВО -->
      <sensor name="vl53l0x_5" type="gpu_lidar">
        <pose>0.045 -0.078 0 0 0 5.2360</pose>
        <topic>/drone/vl53l0x/ch5</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.03</min><max>2.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </lidar>
      </sensor>

    </link>
  </model>
</sdf>