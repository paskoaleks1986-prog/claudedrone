<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- W-core «Column Corridor» (спринт v4_A1_memory_infra, P-SIM).
       Геометрия по контракту researchbest (HANDOFF 2026-06-22 18:0x):
         коридор ~10×2.2м (= gz A1), 3 пилона Ø0.4 поочерёдно L/R @ x=3/6/9,
         высота 1.5м; спавн x=0.5 центр, нос +x; ЗАДНЯЯ СТЕНА = border_west (x=0,
         за спавном) → после входа уходит за спину = цель hidden_rear_wall_dist.
       Фрейм: X∈[0,10] (вдоль коридора), Y∈[-1.1,1.1]; L=+y (port), R=-y.
       Формат как base_stand / A1: БЕЗ <gui> (Aleks 2026-06-15 → дефолтная
       свободная орбит-камера). Стены h=2.5/толщ.0.1, север=красный.
       ArduPilot params = реюз A1. -->
  <world name="column_corridor">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <!-- ArduPilot navsat/AHRS init anchor (реюз A1). -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="main_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <!-- Пол: центр (5,0), 10.2×2.2 (X∈[-0.1,10.1], Y∈[-1.1,1.1]). -->
    <model name="floor">
      <static>true</static>
      <pose>5.0 0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>10.2 2.2 0.05</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>10.2 2.2 0.05</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.72 0.74 0.76 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ЗАДНЯЯ СТЕНА (border_west @ x=0) — цель hidden_rear_wall_dist.
         Внутренняя грань на x=0; за спавном (x=0.5) → уходит за спину. -->
    <model name="border_west">
      <static>true</static>
      <pose>-0.0500 0.0000 1.250 0 0 0.00000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.1000 2.2000 2.500</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.1000 2.2000 2.500</size></box></geometry>
          <material>
            <ambient>0.62 0.55 0.45 1</ambient>
            <diffuse>0.62 0.55 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Дальний конец коридора (border_east @ x=10). -->
    <model name="border_east">
      <static>true</static>
      <pose>10.0500 0.0000 1.250 0 0 0.00000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.1000 2.2000 2.500</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.1000 2.2000 2.500</size></box></geometry>
          <material>
            <ambient>0.8 0.82 0.85 1</ambient>
            <diffuse>0.8 0.82 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="border_south">
      <static>true</static>
      <pose>5.0000 -1.0500 1.250 0 0 0.00000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>10.2000 0.1000 2.500</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>10.2000 0.1000 2.500</size></box></geometry>
          <material>
            <ambient>0.8 0.82 0.85 1</ambient>
            <diffuse>0.8 0.82 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="border_north">
      <static>true</static>
      <pose>5.0000 1.0500 1.250 0 0 0.00000</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>10.2000 0.1000 2.500</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>10.2000 0.1000 2.500</size></box></geometry>
          <material>
            <ambient>0.85 0.12 0.12 1</ambient>
            <diffuse>0.85 0.12 0.12 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Пилоны Ø0.4 (cylinder r=0.2, h=1.5, z центр 0.75), поочерёдно L/R,
         шаг 3м. pylon_0 L@x=3, pylon_1 R@x=6, pylon_2 L@x=9. y=±0.5. -->
    <model name="pylon_0">
      <static>true</static>
      <pose>3.0 0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.25 0.45 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="pylon_1">
      <static>true</static>
      <pose>6.0 -0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.25 0.45 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="pylon_2">
      <static>true</static>
      <pose>9.0 0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.25 0.45 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Drone spawn — x=0.5 центр, нос +x; z=0.2 (clearance), takeoff_node поднимет. -->
    <include>
      <uri>model://iris_claudedrone</uri>
      <pose>0.500 0.000 0.2 0 0 0.0000</pose>
    </include>

  </world>
</sdf>
