<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- lab_room_12x12 — база lab_room (свободная дефолт-камера, БЕЗ <gui>-блока),
       масштаб 12×12м (X,Y∈±6), стены 2.5м, БЕЗ колонны. Северная стена красная (ориентир).
       Создан для ручного облёта Aleks 2026-06-11 (большой пустой зал). -->
  <world name="lab_room_12x12">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <!-- Geographic anchor for ArduPilot navsat/AHRS init (обязательно). SITL home. -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="main_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <!-- Зал 12×12м (X,Y∈±6), стены 2.5м, БЕЗ колонны. -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12 12 0.05</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>12 12 0.05</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.72 0.74 0.76 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.3 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.3 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.12 0.12 1</ambient><diffuse>0.85 0.12 0.12 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.3 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.3 0.15 2.5</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient><diffuse>0.80 0.82 0.85 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 12.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 12.0 2.5</size></box></geometry>
          <material><ambient>0.82 0.84 0.87 1</ambient><diffuse>0.82 0.84 0.87 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>6 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 12.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 12.0 2.5</size></box></geometry>
          <material><ambient>0.82 0.84 0.87 1</ambient><diffuse>0.82 0.84 0.87 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Дрон — центр (0,0): колонны нет, до любой стены 6м (>> prearm proximity 0.6м). -->
    <include>
      <uri>model://iris_claudedrone</uri>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

  </world>
</sdf>
