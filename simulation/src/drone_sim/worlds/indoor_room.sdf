<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="indoor_room">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- Основной свет -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <!-- Дополнительный точечный свет в центре комнаты -->
    <light type="point" name="room_light">
      <pose>0 0 2.3 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.4</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Пол — светло-бежевый -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>5 4 0.05</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>5 4 0.05</size></box></geometry>
          <material>
            <ambient>0.85 0.80 0.65 1</ambient>
            <diffuse>0.85 0.80 0.65 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Стена север — голубая -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>5 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>5 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.8 0.9 1</ambient>
            <diffuse>0.6 0.8 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Стена юг — зелёная -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>5 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>5 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.9 0.6 1</ambient>
            <diffuse>0.6 0.9 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Стена запад — жёлтая -->
    <model name="wall_west">
      <static>true</static>
      <pose>-2.5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.15 4 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.15 4 2.5</size></box></geometry>
          <material>
            <ambient>0.95 0.90 0.55 1</ambient>
            <diffuse>0.95 0.90 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Стена восток — розовая -->
    <model name="wall_east">
      <static>true</static>
      <pose>2.5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.15 4 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.15 4 2.5</size></box></geometry>
          <material>
            <ambient>0.95 0.65 0.65 1</ambient>
            <diffuse>0.95 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Дрон — стартовая позиция в центре -->
    <include>
      <uri>model://claudedrone</uri>
      <pose>0 0 1.0 0 0 0</pose>
    </include>
  </world>
</sdf>