<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="rl_room_empty_6x6">

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>0 0 9 0 1.5707 0</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="state" type="string">floating</property>
          <property type="bool" key="visible">false</property>
        </ignition-gui>
      </plugin>
    </gui>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <!-- ArduPilot navsat/AHRS init anchor (TASK-021 21a fix). Без этого
         EKF/AHRS hang и arducopter не emit'ит MAVLink heartbeat. -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="main_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <!-- Floor 6.4×6.4 m -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>6.4 6.4 0.05</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>6.4 6.4 0.05</size></box></geometry>
          <material>
            <ambient>0.85 0.80 0.65 1</ambient>
            <diffuse>0.85 0.80 0.65 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0.0 3.1500000000000004 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>6.4 0.1 4.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>6.4 0.1 4.0</size></box></geometry>
          <material>
            <ambient>0.6 0.8 0.9 1</ambient>
            <diffuse>0.6 0.8 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0.0 -3.1500000000000004 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>6.4 0.1 4.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>6.4 0.1 4.0</size></box></geometry>
          <material>
            <ambient>0.6 0.9 0.6 1</ambient>
            <diffuse>0.6 0.9 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3.1500000000000004 0.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.1 6.4 4.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.1 6.4 4.0</size></box></geometry>
          <material>
            <ambient>0.95 0.65 0.65 1</ambient>
            <diffuse>0.95 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3.1500000000000004 0.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.1 6.4 4.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.1 6.4 4.0</size></box></geometry>
          <material>
            <ambient>0.95 0.9 0.55 1</ambient>
            <diffuse>0.95 0.9 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Прозрачный физический потолок (Aleks 2026-06-08): держит дрон от
         вертикального ухода + виден дрон на видео (alpha 0.3). z=4.0 = top of
         walls. Parity-нейтрален: obs = 2D scan на высоте дрона, потолок не виден. -->
    <model name="ceiling">
      <static>true</static>
      <link name="ceiling_link">
        <collision name="ceiling_col">
          <pose>0 0 4.0 0 0 0</pose>
          <geometry><box><size>6.4 6.4 0.05</size></box></geometry>
        </collision>
        <visual name="ceiling_vis">
          <pose>0 0 4.0 0 0 0</pose>
          <geometry><box><size>6.4 6.4 0.05</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 0.3</ambient>
            <diffuse>0.8 0.8 0.8 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Drone spawn — point in spawn_zone — z = 0.2 m (clearance),
         takeoff_node поднимет на operational z = 0.5 m. -->
    <include>
      <uri>model://iris_claudedrone</uri>
      <pose>0.0 0.0 0.2 0 0 0</pose>
    </include>

  </world>
</sdf>
