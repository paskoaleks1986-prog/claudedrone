<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="lab_room">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <!-- Geographic anchor for ArduPilot navsat/AHRS init (обязательно). SITL home. -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="main_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <!-- Лаборатория 6×6м (X,Y∈±3), стены 2.5м, колонна по центру. -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 6 0.05</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>6 6 0.05</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.72 0.74 0.76 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 3 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.3 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.3 0.15 2.5</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient><diffuse>0.80 0.82 0.85 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.3 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.3 0.15 2.5</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient><diffuse>0.80 0.82 0.85 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 6.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 6.0 2.5</size></box></geometry>
          <material><ambient>0.82 0.84 0.87 1</ambient><diffuse>0.82 0.84 0.87 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>3 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 6.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 6.0 2.5</size></box></geometry>
          <material><ambient>0.82 0.84 0.87 1</ambient><diffuse>0.82 0.84 0.87 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Колонна по центру — цилиндр R=0.4, высота 2.5 -->
    <model name="column_center">
      <static>true</static>
      <pose>0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.4</radius><length>2.5</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.4</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Дрон — юго-западный угол -->
    <include>
      <uri>model://iris_claudedrone</uri>
      <pose>-2.3 -2.3 0.2 0 0 0</pose>
    </include>

  </world>
</sdf>
